---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Unlisted: nothing links here, and the layout emits a noindex robots tag.
// Presented without naming the source of the footage. No company name, no footage hosted here.
const accent = '#1F7A6B';
const accentSoft = '#DFF1EC';
const accentInk = '#0E3B34';

// Annotated demos. Paste YouTube ids here as they go up; buttons appear automatically.
const videos: { label: string; youtube: string; start?: number }[] = [
  { label: 'Entrance camera', youtube: 'HZ1cOUGwjpA' },
  { label: 'Interior camera', youtube: 'LqiBGYmUYO8' },
];

const specs = ['2 × 10 min CCTV', 'YOLO11m-pose', 'BoT-SORT', 'Shapely floor geometry', 'Shared episode FSM', 'Docker'];

const tasks = [
  {
    n: 'Task 1',
    title: 'Store interest and conversion',
    rows: [['Total interested', '14'], ['Interested entered', '10'], ['Interested passed by', '4']],
    note: 'Scored against 39 blind hand labels: precision 0.80, recall 0.50. On the 27 the reviewer marked confident, precision is 1.00 and recall 0.60.',
  },
  {
    n: 'Task 2',
    title: 'Per-shelf interest',
    rows: [['Shelf A', '6'], ['Shelf B', '4'], ['Shelf C', '3'], ['Shelf D', '2']],
    note: '15 events across 11 distinct customers. No hand labels here: five long episodes were spot-checked frame by frame instead.',
  },
  {
    n: 'Task 3',
    title: 'Staff-customer interaction',
    rows: [['Staff instances', '7'], ['Interaction sessions', '4'], ['Sessions per instance', '0.57']],
    note: '4 sessions divided by 7 staff instances. By the counting rule, a staff member who leaves and returns counts as a new instance.',
  },
];

const probes = [
  {
    title: 'Both files misreport their frame rate, and by different amounts',
    body: 'Both containers declare 30 fps. Read frame by frame against the burnt-in CCTV clock, each clip spans exactly 600 seconds: 13,421 frames at 22.368 fps, and 12,947 at 21.578. Deriving time as frame ÷ 30 overstates elapsed time by 34% in one clip and 39% in the other. A rule written as "2.0 s of sustained attention" would have quietly meant 2.68 s in the first video and 2.78 s in the second, so the same rule would not mean the same thing in both. Time is derived per video from the measured rate, and a test asserts it.',
  },
  {
    title: 'The metric scale is calibrated from the people in the footage',
    body: 'There is no calibration target in the footage and no survey of the site, but adult standing height is roughly constant, so a person is a ruler that walks around. For a level pinhole camera, a standing person’s pixel height is linear in the image row of their feet and reaches zero at the horizon. Fitted over 2,891 rulers at the entrance and 2,055 inside, that gives r = 0.881 and 0.964, with residuals of 14.8 px and 10.6 px. One detail mattered more than the fit itself: a person standing in view for 40 s contributes about 900 near-identical rows, which is one measurement repeated rather than 900 measurements. Capping each track at 40 evenly spaced samples moved r from 0.832 to 0.881 and pulled the implied camera height from an implausible 8.23 m down to 7.35 m. The checks that do not depend on the fit: the walkway measures 12.8 m by 3.2 m, the shopfront 10.3 m, and p90 walking speed comes out at 1.20 m/s and 1.06 m/s against a published band of 1.2 to 1.4.',
  },
  {
    title: 'Gait cadence is a free check on the timebase',
    body: 'Ankle separation, normalised by box height, peaks once per step, so counting prominent peaks gives steps per second, and human walking cadence is a known constant. Entrance walkers measure 1.72 steps/s against a human band of 1.6 to 2.4, and 0.39 while stationary. The check also caught a bug: the first implementation counted zero crossings of the detrended signal and reported about 4 steps/s, roughly twice the human band, because keypoint jitter adds several crossings per step. Counting prominent peaks instead asks whether the legs actually separated and came back together, rather than whether two dots wobbled. The biomechanical constant is what made the bug visible at all.',
  },
  {
    title: 'Orientation had a mirror bug, and the first validation could not see it',
    body: 'Interest is defined as looking toward the storefront, which means facing and travelling are different directions, so an estimator that assumes people face where they walk cannot detect the behaviour being asked for. The shoulder line constrains whether someone faces toward or away from the camera and says nothing about screen-left versus screen-right, so every side-on frame admits two solutions that fit equally well, and the original estimator picked whichever one noise favoured. The first validation missed this entirely: 40 hand-labelled crops reported 50° median error, because the labels and the estimator came from the same person, so a misread blurry crop was misread the same way twice and the errors cancelled. The check that caught it needs no labels. Brisk walkers face where they are going, so direction of travel is a free reference across thousands of frames that nobody authored. Against it, the original estimator read 117° median error with 40% near-reversed; after taking the toward-or-away sign from the signed shoulder offset and the left-or-right sign from where the nose sits relative to the shoulder midpoint, it reads 28° with 5% reversed. Run against the repaired estimator, the old hand-label probe still reports 52°, which is the clearest possible demonstration that the instrument was blind.',
  },
  {
    title: 'The walkway is only two metres deep, which changes what distance means',
    body: 'Measured from the ground-point distribution, the visible walkway band spans floor depth 6.9 to 9.0 m while the shopfront sits at 6.7 to 7.9 m, so every person on the walkway is between 0.04 m and 1.25 m from the frontage. Distance therefore has to be resolved at the scale of about a metre. A 2.5 m proximity radius, which sounds like a reasonable choice, would score every walkway person identically and carry no information whatsoever. The proximity cues run from full at 0.3 m to zero at 1.5 m instead.',
  },
];

const models = [
  ['Detection, tracking, pose', 'YOLO11m-pose with BoT-SORT', 'One forward pass gives the box, the track and 17 keypoints. Pose costs nothing over plain detection, and everything behavioural here needs keypoints: ankles are a far steadier ground point than a box bottom, which jumps whenever legs are occluded.'],
  ['Zone geometry', 'Shapely', 'Shelf footprints, the walkway band and the shopfront line, all resolved on the floor plane rather than in pixels.'],
  ['Classifier experiment', 'scikit-learn', 'Used for the staff-classifier probe, which was run, measured against the simple colour rule, and then not shipped.'],
  ['Config', 'pydantic, fail-fast', 'Every threshold is typed scene config with unknown keys forbidden, so a silently ignored parameter cannot happen.'],
  ['Encoding', 'ffmpeg and libx264', 'Browser-playable output, which OpenCV’s own writer does not reliably produce.'],
];
---

<BaseLayout
  title="Retail Behavioural Analytics · Vignesh K"
  description="An end-to-end video analytics pipeline over two CCTV clips: store interest and conversion, per-shelf engagement, and staff-customer interaction, with every number checkable against the footage."
  noindex={true}
  scripts={videos.length ? ['case-video.js'] : []}
>
  <article class="rv shell" style={`--rv-accent:${accent};--rv-soft:${accentSoft};--rv-ink:${accentInk};`}>
    <header class="rv-hero animate-fade-in-up">
      <div class="rv-hero__meta">
        <span class="rv-badge">Unlisted</span>
        <span class="rv-dot">·</span>
        <span>Applied computer vision</span>
        <span class="rv-dot">·</span>
        <span>September 2026</span>
      </div>
      <h1>Retail Behavioural Analytics</h1>
      <p class="rv-tagline">
        Two ten-minute CCTV clips from a shoe store in a shopping mall. Measure who showed interest and who
        came in, which shelves held attention, and how often staff engaged customers. Then
        <span class="rv-em">render every decision back onto the footage</span>, so each number can be checked
        against what the camera saw.
      </p>
      <ul class="rv-specs" aria-label="At a glance">{specs.map((s) => <li>{s}</li>)}</ul>
      <a class="rv-doc" href="/assets/retail/retail-behavioural-analytics.pdf" target="_blank" rel="noopener">
        <span aria-hidden="true">↓</span>
        <span>Read the full write-up<em>36 pages, PDF, 3.9 MB</em></span>
      </a>
    </header>

    <section class="rv-block animate-fade-in-up delay-1">
      <div class="rv-block__head"><h2>Results</h2><span class="rv-tag">Measured, not estimated</span></div>
      <div class="rv-tasks">
        {tasks.map((task) => (
          <div class="rv-task">
            <p class="rv-task__n">{task.n}</p>
            <h3>{task.title}</h3>
            <dl>{task.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
            <p class="rv-task__note">{task.note}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="rv-block animate-fade-in-up delay-1">
      <div class="rv-block__head">
        <h2>What the camera saw</h2>
        {videos.length > 0 && (
          <div class="rv-videobar">
            {videos.map((video, i) => (
              <button class={`rv-demo${i ? ' rv-demo--ghost' : ''}`} type="button" data-demo-youtube={video.youtube} data-demo-start={video.start} data-demo-title={`Retail analytics · ${video.label}`}><span aria-hidden="true">▶</span> {video.label}</button>
            ))}
          </div>
        )}
      </div>
      <div class="rv-frames">
        <figure>
          <img src="/assets/retail/frame-entrance.jpg" alt="Annotated entrance camera frame with tracked people, a shopfront line and a running metrics overlay" loading="lazy" />
          <figcaption>Entrance camera. Each track carries an id and a state: passer-by, interested, entered or staff. The running totals in the corner are the same numbers the CSV ships.</figcaption>
        </figure>
        <figure>
          <img src="/assets/retail/frame-shelves.jpg" alt="Annotated interior camera frame with four labelled shelf zones and per-shelf event counts" loading="lazy" />
          <figcaption>Interior camera. Four shelf zones drawn on the floor plane, each with its live event count; a box turns yellow only while a customer is engaged with that shelf.</figcaption>
        </figure>
      </div>
    </section>

    <section class="rv-block animate-fade-in-up delay-1">
      <div class="rv-block__head"><h2>How it works</h2><span class="rv-tag">Three passes, two cached seams</span></div>
      <div class="rv-passes">
        <div class="rv-pass">
          <p class="rv-pass__n">Pass 1</p><h3>Perception</h3>
          <p>Detection, tracking and pose straight off the raw video, about seven minutes a clip. This is the only stage that needs a GPU, and the only one that cannot be reproduced bit for bit elsewhere, so its output is committed to the repo.</p>
        </div>
        <div class="rv-pass">
          <p class="rv-pass__n">Pass 2</p><h3>Analytics</h3>
          <p>Geometry, attention and the three tasks, as deterministic CPU arithmetic over that cached table. It runs in seconds, so a threshold change costs seconds rather than eleven minutes, and it emits one event file.</p>
        </div>
        <div class="rv-pass">
          <p class="rv-pass__n">Pass 3</p><h3>Render</h3>
          <p>Draws the annotated video from the same event file the CSVs are formatted from, about ninety seconds a clip. It applies no threshold and derives no episode.</p>
        </div>
      </div>
      <div class="rv-why">
        <p><strong>Why the seams sit there.</strong> Detection and tracking are the only stage needing a GPU, and the only one that cannot be reproduced bit for bit on another machine. Everything downstream is deterministic CPU arithmetic. Committing the track table means a reviewer with no GPU regenerates every number in the write-up in about thirty seconds.</p>
        <p><strong>Pass 3 decides nothing.</strong> Every count, episode and verdict drawn on the video is read from the same event file the CSVs are formatted from. The renderer computes presentation detail, such as an elapsed timer on an active session, but it applies no threshold and derives no episode, so there is no second implementation of any rule for the video and the CSV to disagree about. A test asserts that equality rather than trusting it.</p>
        <p><strong>One counting rule, shared by all three tasks.</strong> All three questions turn out to be the same question: given a noisy per-frame score for one subject and one target, how many distinct sustained episodes occurred? Solving that once, in one tested module, is why the three tasks cannot disagree about what a single event means.</p>
      </div>
    </section>

    <section class="rv-block animate-fade-in-up delay-1">
      <div class="rv-block__head"><h2>What was measured before anything was built</h2><span class="rv-tag">Four findings that changed the design</span></div>
      <ol class="rv-probes">
        {probes.map((probe) => (
          <li><h3>{probe.title}</h3><p>{probe.body}</p></li>
        ))}
      </ol>
    </section>

    <section class="rv-block animate-fade-in-up delay-1">
      <div class="rv-block__head"><h2>Accuracy, and how much the thresholds matter</h2><span class="rv-tag">In-domain, and said so</span></div>
      <div class="rv-why">
        <p>Task 1 is scored against <strong>39 blind hand labels</strong>. Across all of them the pipeline reaches precision 0.80 and recall 0.50, for an F1 of 0.62. On the 27 labels the reviewer marked confident it reaches <strong>precision 1.00 and recall 0.60</strong>, an F1 of 0.75, with no false positives at all: everyone the pipeline calls interested is interested, and both hand-verified entries are found. The errors run the other way, towards people who show interest briefly without sustaining it past the threshold.</p>
        <p>A sweep re-runs the analytics across a grid for every threshold that could plausibly matter, and three results are worth pulling out. <strong>Task 1 is bound by the interest threshold</strong>, which walks the totals from 38 interested at 0.20 down to 12 at 0.40 while the entered count sits at 10 throughout. That is the partition working as designed: entry is decided by geometry, so the interest score cannot interfere with it. <strong>Task 2 is bound by the proximity floor</strong>, the parameter added last, which moves the count from 13 events across 9 customers to 20 across 16. Pure orientation misses people browsing the shelf they already stand at, and pure proximity credits anyone who walks past one, so the shipped value sits between them. <strong>Task 3 sits on a plateau only two points wide</strong>: 3.0 s and 4.0 s both give 4 sessions and 0.57, while 2.0 s gives 5 and 5.0 s gives 3. That is narrower than anyone would want, and it is named as the least well-supported threshold in the submission rather than left for a reader to find. Meanwhile the group-merge gap <strong>does nothing at all</strong>, staying flat from 0 to 20 seconds, because no two episodes of the same staff instance fall that close without already overlapping. It is reported because it is inert: a carefully documented parameter with no effect sends a reader’s scrutiny to the wrong place.</p>
      </div>
    </section>

    <section class="rv-block animate-fade-in-up delay-1">
      <div class="rv-block__head"><h2>What it gets wrong</h2><span class="rv-tag">Each miss explained</span></div>
      <div class="rv-why">
        <p><strong>One false positive, four misses.</strong> The single false positive slows near the frontage while walking past, on a label the reviewer marked unsure, which is exactly where the boundary is genuinely fuzzy; it disappears on the confident-only subset, which is why precision there is 1.00. Of the misses, three were originally labelled as entering the shop, and frame-by-frame review showed all three stay outside the shopfront and leave at the right edge of frame, so the labels were corrected and the reason recorded. They still carry an interested label the pipeline does not reproduce, peaking at 0.41, 0.32 and 0.71 without sustaining an episode. The clearest genuine miss is a 15 s zigzag along the frontage, repeatedly turning toward the window, peaking at 0.41.</p>
        <p><strong>The staff denominator is wrong in the flattering direction.</strong> Three staff appearances are missed: two where the employee is seen mostly from behind and the apron is not visible, and one with only three qualifying crops. So the Task 3 denominator is 7 rather than 10, which <em>raises</em> the reported average from 0.40 to 0.57. Separately, several people in white tops kneel to fit shoes onto seated customers, which is staff behaviour by any ordinary reading, but staff are defined here by the apron, so they are counted as customers. That is a scope decision rather than an oversight.</p>
        <p><strong>Interior cadence falls below the human band</strong>, at 1.08 steps per second against 1.6 to 2.4. The cause is visible in the data: 54% of interior ground points come from the box bottom rather than the ankles, because fixtures occlude feet, so step peaks are missed and intervals overestimated. The entrance clip, where 79% of ground points are ankle-derived, lands inside the band.</p>
      </div>
    </section>

    <section class="rv-block animate-fade-in-up delay-1">
      <div class="rv-block__head"><h2>Models and libraries</h2></div>
      <div class="rv-models">
        {models.map(([part, choice, why]) => (
          <div class="rv-model"><p class="rv-model__part">{part}</p><p class="rv-model__choice">{choice}</p><p class="rv-model__why">{why}</p></div>
        ))}
      </div>
    </section>

    <footer class="rv-foot animate-fade-in-up delay-1">
      <p>The pipeline is packaged to reproduce. Everything except the GPU detection pass regenerates from the committed track table, so all three CSVs and both event files rebuild from a Docker image in about thirty seconds, with no GPU and no network. The test suite is 64 tests, and it runs in the same image.</p>
      <p class="rv-foot__links">
        <a href="/assets/retail/retail-behavioural-analytics.pdf" target="_blank" rel="noopener">Full write-up, 36 pages (PDF) ↗</a>
        <a href="mailto:vignesh0702@gmail.com">Questions about the build → vignesh0702@gmail.com</a>
      </p>
    </footer>

    {videos.length > 0 && (
      <dialog class="demo" id="demo-dialog" aria-label="Annotated footage">
        <div class="demo__bar"><p class="demo__title"></p><button class="demo__close" type="button" aria-label="Close video">✕</button></div>
        <div class="demo__frame"></div>
      </dialog>
    )}
  </article>

  <style>
    .rv { padding: var(--s-8) 0 var(--s-12); max-width: 1000px; }

    .rv-hero { padding-bottom: var(--s-8); border-bottom: 1px solid var(--hairline); margin-bottom: var(--s-8); }
    .rv-hero__meta {
      display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-2);
      font-size: var(--t-tiny); font-weight: 600; letter-spacing: .06em;
      text-transform: uppercase; color: var(--muted); margin-bottom: var(--s-4);
    }
    .rv-dot { color: var(--hairline); }
    .rv-badge { background: var(--rv-soft); color: var(--rv-ink); padding: 3px 10px; border-radius: 999px; letter-spacing: .04em; }
    .rv-hero h1 {
      font-family: var(--font-display); font-size: clamp(44px, 6vw, 82px); font-weight: 400;
      line-height: 1; letter-spacing: -.03em; margin-bottom: var(--s-4);
    }
    .rv-tagline { max-width: 720px; font-size: clamp(17px, 2.2vw, 22px); line-height: 1.55; color: var(--ink-soft); }
    .rv-em { color: var(--rv-accent); font-weight: 600; }
    .rv-specs { list-style: none; display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-3); margin-top: var(--s-6); padding: 0; }
    .rv-specs li {
      padding: 5px 10px; border: 1px solid var(--hairline); border-radius: 3px;
      font-family: var(--mono); font-size: 11px; color: var(--ink-soft);
    }

    .rv-block { margin-bottom: var(--s-9); }
    .rv-block__head {
      display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap;
      gap: var(--s-3); margin-bottom: var(--s-6);
      padding-bottom: var(--s-3); border-bottom: 1px solid var(--hairline);
    }
    .rv-block__head h2 { font-family: var(--font-display); font-size: var(--t-h2); font-weight: 400; letter-spacing: -.02em; }
    .rv-tag { font-family: var(--mono); font-size: 11px; color: var(--muted); letter-spacing: .06em; text-transform: uppercase; }

    .rv-tasks { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-4); }
    .rv-task { display: flex; flex-direction: column; padding: var(--s-5); border: 1px solid var(--hairline); background: var(--bg-raised); }
    .rv-task__n { font-family: var(--mono); font-size: 11px; color: var(--rv-accent); letter-spacing: .1em; text-transform: uppercase; }
    .rv-task h3 { margin: var(--s-2) 0 var(--s-4); font-family: var(--font-display); font-size: 23px; font-weight: 400; line-height: 1.2; }
    .rv-task dl { margin: 0; }
    .rv-task dl > div { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); padding: 9px 0; border-top: 1px solid var(--hairline); }
    .rv-task dt { color: var(--ink-soft); font-size: var(--t-small); }
    .rv-task dd { margin: 0; font-family: var(--font-display); font-size: 26px; line-height: 1; }
    .rv-task__note { margin-top: var(--s-4); padding-top: var(--s-4); border-top: 1px solid var(--hairline); color: var(--muted); font-size: var(--t-tiny); line-height: 1.6; }

    .rv-videobar { display: flex; flex-wrap: wrap; gap: var(--s-2); }
    .rv-demo {
      display: inline-flex; align-items: center; gap: 9px; min-height: 38px; padding: 0 15px;
      border: 0; border-radius: 4px; background: var(--rv-accent); color: #fff;
      font: inherit; font-size: 13px; font-weight: 650; cursor: pointer; transition: transform var(--ease);
    }
    .rv-demo span { font-size: 10px; }
    .rv-demo:hover { transform: translateY(-2px); }
    .rv-demo--ghost { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1px var(--hairline); }

    .rv-frames { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s-5); }
    .rv-frames figure { margin: 0; }
    .rv-frames img { width: 100%; height: auto; border-radius: 3px; border: 1px solid var(--hairline); }
    .rv-frames figcaption { margin-top: var(--s-3); color: var(--muted); font-size: var(--t-tiny); line-height: 1.65; }

    .rv-passes { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-4); margin-bottom: var(--s-6); }
    .rv-pass { padding: var(--s-5); border-left: 2px solid var(--rv-accent); background: var(--bg-soft); }
    .rv-pass__n { font-family: var(--mono); font-size: 11px; color: var(--rv-accent); letter-spacing: .1em; text-transform: uppercase; }
    .rv-pass h3 { margin: var(--s-2) 0 var(--s-3); font-family: var(--font-display); font-size: 21px; font-weight: 400; }
    .rv-pass p { color: var(--ink-soft); font-size: var(--t-small); line-height: 1.65; }
    .rv-why { display: grid; gap: var(--s-4); max-width: 780px; }
    .rv-why p { color: var(--ink-soft); font-size: var(--t-body); line-height: 1.75; }
    .rv-why strong { color: var(--ink); }

    .rv-probes { max-width: 820px; margin: 0; padding: 0; list-style: none; counter-reset: probe; }
    .rv-probes li { padding: var(--s-5) 0; border-top: 1px solid var(--hairline); counter-increment: probe; }
    .rv-probes li:first-child { border-top: 0; padding-top: 0; }
    .rv-probes h3 { font-size: 19px; font-weight: 650; line-height: 1.35; }
    .rv-probes h3::before { content: counter(probe) " · "; color: var(--rv-accent); font-family: var(--mono); font-size: 13px; }
    .rv-probes p { margin-top: var(--s-3); color: var(--ink-soft); font-size: var(--t-body); line-height: 1.75; }

    .rv-models { display: grid; gap: 0; }
    .rv-model { display: grid; grid-template-columns: 170px 210px 1fr; gap: var(--s-4); padding: var(--s-4) 0; border-top: 1px solid var(--hairline); align-items: baseline; }
    .rv-model__part { font-size: var(--t-small); font-weight: 650; }
    .rv-model__choice { font-family: var(--mono); font-size: 12px; color: var(--rv-accent); }
    .rv-model__why { color: var(--ink-soft); font-size: var(--t-small); line-height: 1.65; }

    .rv-foot { padding-top: var(--s-6); border-top: 1px solid var(--hairline); }
    .rv-foot p { max-width: 720px; color: var(--ink-soft); font-size: var(--t-small); line-height: 1.7; }
    .rv-foot__links { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-6); margin-top: var(--s-4); }
    .rv-foot__links a { font-size: var(--t-small); font-weight: 650; color: var(--rv-accent); }

    .rv-doc {
      display: inline-flex; align-items: center; gap: var(--s-3); margin-top: var(--s-5);
      padding: 12px 18px; border: 1px solid var(--hairline); border-radius: 4px;
      background: var(--rv-soft); color: var(--rv-ink);
      font-size: var(--t-small); font-weight: 650; transition: transform var(--ease);
    }
    .rv-doc:hover { transform: translateY(-2px); }
    .rv-doc > span:first-child { font-size: 15px; }
    .rv-doc em { display: block; margin-top: 2px; font-family: var(--mono); font-size: 11px; font-style: normal; font-weight: 400; opacity: .72; }

    .demo { width: min(1100px, calc(100vw - 32px)); max-width: none; margin: auto; padding: 0; border: 0; border-radius: 8px; overflow: hidden; background: #0c0b14; color: #fff; }
    .demo::backdrop { background: rgba(8,7,16,.78); }
    .demo__bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 10px 10px 10px 18px; }
    .demo__title { font-size: 13px; font-weight: 650; }
    .demo__close { width: 36px; height: 36px; border: 0; border-radius: 4px; background: transparent; color: #fff; font-size: 16px; cursor: pointer; }
    .demo__close:hover { background: rgba(255,255,255,.12); }
    .demo__frame { position: relative; width: 100%; aspect-ratio: 16/9; background: #000; }
    /* the player is created by script after render, so it never gets Astro's scope attribute */
    .demo__frame :global(iframe), .demo__frame :global(video) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

    @media (max-width: 900px) {
      .rv-tasks, .rv-passes, .rv-frames { grid-template-columns: 1fr; }
      .rv-model { grid-template-columns: 1fr; gap: var(--s-2); }
    }
  </style>
</BaseLayout>
